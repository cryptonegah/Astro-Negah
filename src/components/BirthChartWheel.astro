    width: 100%;
    padding: 4px 0 10px;
  }

  .wheel-placeholder {
    padding: 30px 20px;
    border: 1px solid rgba(155, 124, 255, 0.18);
    border-radius: 18px;
    background: rgba(155, 124, 255, 0.05);
    text-align: center;
  }

  .wheel-placeholder-title {
    margin-bottom: 8px;
    color: #c5b2ff;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .wheel-placeholder-text {
    color: #aaa7c7;
    line-height: 1.9;
  }

  .wheel-header {
    margin-bottom: 18px;
    text-align: center;
  }

  .wheel-header h3 {
    margin: 0 0 8px;
