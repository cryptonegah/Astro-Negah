    font-size: 1.25rem;
  }

  .wheel-header p {
    margin: 0;
    color: #aaa7c7;
    line-height: 1.8;
  }

  .wheel-container {
    width: min(100%, 760px);
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .birth-chart-svg {
    display: block;
    width: 100%;
    height: auto;
    max-width: 760px;
    overflow: visible;
  }

  .chart-background {
    fill: url(#chartBackground);
  }

  .outer-ring,
  .inner-ring,
  .planet-orbit {
    fill: none;
    stroke: rgba(197, 178, 255, 0.5);
    stroke-width: 1.5;
  }

  .zodiac-divider {
    stroke: rgba(197, 178, 255, 0.32);
    stroke-width: 1;
  }

  .zodiac-label {
    fill: #c5b2ff;
