    font-weight: 700;
  }

  .zodiac-name {
    fill: #aaa7c7;
    font-size: 13px;
  }

  .house-line {
    stroke: rgba(143, 156, 255, 0.3);
    stroke-width: 1;
  }

  .house-label {
