<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro Negah — داستان تو در ستارگان</title>
    <meta
      name="description"
      content="Astro Negah — نگاهی به داستانی که ستارگان می‌نویسند."
    />
  </head>

  <body>
    <div class="cosmos-bg" aria-hidden="true">
      <div class="galaxy-image"></div>
      <div class="galaxy-purple"></div>
      <div class="galaxy-depth"></div>
      <div class="nebula nebula-one"></div>
      <div class="nebula nebula-two"></div>
      <div class="nebula nebula-three"></div>
      <div class="stars stars-one"></div>
      <div class="stars stars-two"></div>
      <div class="stars stars-three"></div>
      <div class="light-orb orb-one"></div>
      <div class="light-orb orb-two"></div>
      <div class="light-orb orb-three"></div>
      <div class="cosmic-vignette"></div>
    </div>

    <header class="site-header">
      <a href="/" class="logo" aria-label="Astro Negah">
        <span class="logo-mark">✦</span>
        <span>Astro Negah</span>
      </a>

      <nav class="main-nav" aria-label="منوی اصلی">
        <a href="#features">کشف کن</a>
        <a href="#zodiac">زودیاک</a>
        <a href="#about">درباره</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-glow"></div>

        <div class="hero-content">
          <p class="eyebrow">نگاهی به آسمان تو</p>

          <h1>
            اینجا،<br />
            <span>داستان تو را</span><br />
            ستارگان می‌نویسند.
          </h1>

          <p class="hero-description">
            آسمان لحظه تولدت داستانی منحصربه‌فرد دارد. در Astro Negah، این
            داستان را از میان ستارگان کشف کن.
          </p>

          <div class="hero-actions">
            <a href="#features" class="primary-button">
              داستان من را کشف کن
              <span aria-hidden="true">&#8592;</span>
            </a>

            <a href="#zodiac" class="secondary-button">
              نشانه خودت را پیدا کن
            </a>
          </div>

          <p class="hero-note">آسمان همیشه چیزی برای گفتن دارد</p>
        </div>

        <div class="scroll-indicator" aria-hidden="true">
          <span></span>
        </div>
      </section>

      <section class="intro" id="about">
        <div class="section-orbit" aria-hidden="true">
          <span></span>
        </div>

        <div class="intro-content">
          <p class="section-label">ASTRO NEGAH</p>

          <h2>
            هر انسان،<br />
            یک آسمان<br />
            منحصر به فرد دارد.
          </h2>

          <p>
            ستارگان فقط نورهایی دور در آسمان نیستند. برای هزاران سال،
            انسان‌ها به آسمان نگاه کرده‌اند تا معنا، الگو و داستان خود را
            پیدا کنند. حالا نوبت توست که به آسمان خودت نگاه کنی.
          </p>
        </div>
      </section>

      <section class="features-section" id="features">
        <div class="section-heading">
          <p class="section-label">کشف کن</p>

          <h2>آسمان تو، داستان تو</h2>

          <p>
            از شناخت نشانه زودیاک تا کشف نقشه شخصی تولد، مسیر خودت را در میان
            ستارگان پیدا کن.
          </p>
        </div>

        <div class="features-grid">
          {features.map((feature, index) => (
            <a href={feature.href} class="feature-card">
              <span class="feature-number">0{index + 1}</span>

              <div class="feature-icon" aria-hidden="true">
                <span></span>
              </div>

              <div class="feature-content">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>

              <span class="feature-arrow" aria-hidden="true">&#8592;</span>
            </a>
          ))}
        </div>
      </section>

      <section class="zodiac-section" id="zodiac">
        <div class="section-heading zodiac-heading">
          <p class="section-label">دایره زودیاک</p>

          <h2>
            کدام نشانه<br />
            داستان تو را می‌گوید؟
          </h2>

          <p>
            دوازده نشانه، دوازده انرژی متفاوت. نشانه خودت را انتخاب کن و بیشتر
            درباره آن بدان.
          </p>
        </div>

        <div class="zodiac-grid">
          {zodiacSigns.map((sign) => (
            <a
              href={`/zodiac/${sign.latin.toLowerCase()}`}
              class="zodiac-card"
              aria-label={`نشانه ${sign.name} - ${sign.latin}`}
            >
              <div class="zodiac-symbol">
                <img src={sign.symbol} alt="" />
              </div>

              <span class="zodiac-name">{sign.name}</span>
              <span class="zodiac-latin">{sign.latin}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="final-cta">
        <div class="final-glow" aria-hidden="true"></div>

        <div class="final-content">
          <p class="section-label">داستان هنوز ادامه دارد</p>

          <h2>
            به آسمان نگاه کن.<br />
            شاید جواب آنجاست.
          </h2>

          <a href="#features" class="primary-button">
            شروع سفر من
            <span aria-hidden="true">&#8592;</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <a href="/" class="footer-logo">Astro Negah</a>
        <p>اینجا، داستان تو را ستارگان می‌نویسند.</p>
      </div>

      <span>&copy; 2026 Astro Negah</span>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: #020108;
    color: #f8f5ff;
    font-family: Tahoma, Arial, sans-serif;
    overflow-x: hidden;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  /* =========================
     COSMIC BACKGROUND
     ========================= */

  .cosmos-bg {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse at 50% 42%,
        #28104f 0%,
        #120728 34%,
        #050312 70%,
        #010107 100%
      );
  }

  .galaxy-image {
    position: absolute;
    inset: -4%;
    background-image: url('/images/galaxy-m60.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.82;
    filter:
      saturate(1.38)
      contrast(1.04)
      brightness(0.82);
    transform: scale(1.04);
    animation: galaxy-drift 28s ease-in-out infinite alternate;
  }

  .galaxy-purple {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse at 52% 45%,
        rgba(151, 74, 255, 0.28) 0%,
        rgba(103, 42, 190, 0.22) 25%,
        rgba(52, 16, 108, 0.24) 48%,
        rgba(9, 3, 30, 0.1) 72%
      ),
      linear-gradient(
        115deg,
        rgba(32, 7, 68, 0.3),
        rgba(112, 35, 184, 0.14),
        rgba(25, 5, 55, 0.28)
      );
    mix-blend-mode: screen;
    opacity: 0.9;
  }

  .galaxy-depth {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse at 50% 48%,
        rgba(255, 255, 255, 0.02) 0%,
        rgba(58, 21, 105, 0.08) 26%,
        rgba(11, 4, 29, 0.28) 58%,
        rgba(1, 1, 7, 0.68) 100%
      ),
      linear-gradient(
        180deg,
        rgba(4, 1, 15, 0.36) 0%,
        rgba(52, 13, 103, 0.04) 42%,
        rgba(2, 1, 10, 0.5) 100%
      );
  }

  .nebula {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(70px);
    mix-blend-mode: screen;
  }

  .nebula-one {
    width: 58vw;
    height: 38vw;
    top: 2%;
    right: -14%;
    background: rgba(123, 49, 218, 0.2);
    transform: rotate(-20deg);
    animation: nebula-float-one 18s ease-in-out infinite alternate;
  }

  .nebula-two {
    width: 52vw;
    height: 35vw;
    bottom: 8%;
    left: -15%;
    background: rgba(78, 42, 180, 0.2);
    transform: rotate(25deg);
    animation: nebula-float-two 22s ease-in-out infinite alternate;
  }

  .nebula-three {
    width: 42vw;
    height: 30vw;
    top: 40%;
    left: 30%;
    background: rgba(174, 57, 234, 0.12);
    animation: nebula-pulse 14s ease-in-out infinite alternate;
  }

  /* =========================
     STARS
     ========================= */

  .stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stars-one {
    opacity: 0.9;
    background-image:
      radial-gradient(circle at 8% 18%, #fff 0 1.3px, transparent 2.2px),
      radial-gradient(circle at 17% 72%, #e8dcff 0 1.4px, transparent 2.3px),
      radial-gradient(circle at 29% 28%, #fff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 41% 64%, #d8c5ff 0 1.2px, transparent 2.1px),
      radial-gradient(circle at 53% 14%, #fff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 68% 31%, #eadfff 0 1.3px, transparent 2.2px),
      radial-gradient(circle at 79% 76%, #fff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 91% 42%, #d9c7ff 0 1.2px, transparent 2.1px),
      radial-gradient(circle at 12% 91%, #fff 0 1px, transparent 2px),
      radial-gradient(circle at 34% 82%, #e6d8ff 0 1.4px, transparent 2.3px),
      radial-gradient(circle at 62% 69%, #fff 0 1.1px, transparent 2px),
      radial-gradient(circle at 88% 18%, #e7d9ff 0 1.4px, transparent 2.3px);
    animation: stars-twinkle-one 5.5s ease-in-out infinite alternate;
  }

  .stars-two {
    opacity: 0.7;
    transform: scale(1.15);
    background-image:
      radial-gradient(circle at 12% 48%, #fff 0 1.3px, transparent 2.2px),
      radial-gradient(circle at 24% 86%, #d9c8ff 0 1.5px, transparent 2.4px),
      radial-gradient(circle at 36% 9%, #fff 0 1.2px, transparent 2.1px),
      radial-gradient(circle at 48% 42%, #e9ddff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 61% 82%, #fff 0 1.2px, transparent 2.1px),
      radial-gradient(circle at 74% 18%, #dfd0ff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 87% 61%, #fff 0 1.2px, transparent 2.1px);
    animation: stars-twinkle-two 8s ease-in-out infinite alternate;
  }

  .stars-three {
    opacity: 0.52;
    transform: scale(1.35);
    background-image:
      radial-gradient(circle at 5% 55%, #fff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 22% 34%, #d8c5ff 0 1.2px, transparent 2.1px),
      radial-gradient(circle at 44% 92%, #fff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 66% 57%, #e5d7ff 0 1.2px, transparent 2.1px),
      radial-gradient(circle at 83% 12%, #fff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 96% 88%, #d9c7ff 0 1.2px, transparent 2.1px);
    animation: stars-twinkle-three 11s ease-in-out infinite alternate;
  }

  .light-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(20px);
    mix-blend-mode: screen;
  }

  .orb-one {
    width: 25vw;
    height: 25vw;
    top: 10%;
    left: 4%;
    background: rgba(111, 55, 225, 0.12);
    animation: orb-float 17s ease-in-out infinite alternate;
  }

  .orb-two {
    width: 22vw;
    height: 22vw;
    bottom: 10%;
    right: 3%;
    background: rgba(158, 50, 224, 0.12);
    animation: orb-float 21s ease-in-out infinite alternate-reverse;
  }

  .orb-three {
    width: 15vw;
    height: 15vw;
    top: 45%;
    right: 35%;
    background: rgba(112, 76, 235, 0.1);
    animation: orb-pulse 10s ease-in-out infinite alternate;
  }

  .cosmic-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(1, 1, 7, 0.48),
        transparent 28%,
        transparent 72%,
        rgba(1, 1, 7, 0.48)
      ),
      linear-gradient(
        180deg,
        rgba(1, 1, 8, 0.35),
        transparent 28%,
        transparent 70%,
        rgba(1, 1, 8, 0.55)
      );
  }

  /* =========================
     HEADER
     ========================= */

  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 28px 0;
  }

  .logo,
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .logo-mark {
    color: #d1b8ff;
    font-size: 1.45rem;
    text-shadow:
      0 0 12px #a875ff,
      0 0 30px rgba(157, 91, 255, 0.9);
  }

  .main-nav {
    display: flex;
    gap: 30px;
  }

  .main-nav a {
    color: rgba(245, 242, 255, 0.78);
    font-size: 0.9rem;
    transition:
      color 0.3s ease,
      text-shadow 0.3s ease;
  }

  .main-nav a:hover {
    color: white;
    text-shadow: 0 0 18px rgba(183, 148, 255, 0.9);
  }

  /* =========================
     HERO
     ========================= */

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100vh - 90px);
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 70px 0 130px;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(720px, 100%);
  }

  .hero-glow {
    position: absolute;
    width: 620px;
    height: 620px;
    right: -150px;
    top: 8%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(125, 60, 220, 0.17),
      rgba(70, 25, 135, 0.06) 42%,
      transparent 70%
    );
    filter: blur(8px);
    pointer-events: none;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 20px;
    color: #c8aaff;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    font-weight: 700;
  }

  .hero h1 {
    margin: 0;
    max-width: 760px;
    font-size: clamp(3rem, 7vw, 6.4rem);
    line-height: 1.15;
    letter-spacing: -0.055em;
    font-weight: 800;
    text-shadow:
      0 3px 30px rgba(0, 0, 0, 0.65),
      0 0 50px rgba(92, 49, 163, 0.3);
  }

  .hero h1 span {
    background: linear-gradient(110deg, #ffffff, #decaff 50%, #aa7df2);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-description {
    max-width: 600px;
    margin: 34px 0 0;
    color: rgba(245, 242, 255, 0.76);
    font-size: 1.05rem;
    line-height: 2.1;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 700;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .primary-button {
    background: linear-gradient(135deg, #9259f6, #6132bd);
    box-shadow:
      0 12px 35px rgba(84, 45, 157, 0.45),
      inset 0 1px rgba(255, 255, 255, 0.22);
  }

  .primary-button:hover {
    transform: translateY(-3px);
    box-shadow:
      0 18px 45px rgba(103, 59, 188, 0.55),
      0 0 25px rgba(145, 99, 235, 0.3);
  }

  .secondary-button {
    border: 1px solid rgba(207, 190, 255, 0.25);
    background: rgba(14, 7, 31, 0.45);
    backdrop-filter: blur(12px);
    color: rgba(255, 255, 255, 0.86);
  }

  .secondary-button:hover {
    transform: translateY(-3px);
    background: rgba(72, 45, 122, 0.4);
    border-color: rgba(207, 190, 255, 0.45);
  }

  .hero-note {
    margin-top: 22px;
    color: rgba(245, 242, 255, 0.44);
    font-size: 0.75rem;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 45px;
    left: 50%;
    transform: translateX(-50%);
    width: 20px;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 20px;
  }

  .scroll-indicator span {
    display: block;
    width: 3px;
    height: 8px;
    margin: 7px auto;
    border-radius: 999px;
    background: #d9c9ff;
    box-shadow: 0 0 10px #a77cff;
    animation: scroll-dot 1.8s ease-in-out infinite;
  }

  /* =========================
     SECTIONS
     ========================= */

  .intro,
  .features-section,
  .zodiac-section,
  .final-cta {
    position: relative;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .intro {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 130px 0;
  }

  .intro-content {
    max-width: 650px;
    margin-right: auto;
    padding-right: 4%;
  }

  .intro h2,
  .section-heading h2,
  .final-content h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 1.25;
    letter-spacing: -0.04em;
  }

  .intro p:not(.section-label) {
    max-width: 600px;
    margin-top: 30px;
    color: rgba(245, 242, 255, 0.68);
    line-height: 2.1;
  }

  .section-orbit {
    position: absolute;
    left: -12%;
    top: 25%;
    width: 420px;
    height: 420px;
    border: 1px solid rgba(170, 130, 255, 0.15);
    border-radius: 50%;
    box-shadow:
      0 0 80px rgba(86, 48, 157, 0.1),
      inset 0 0 80px rgba(86, 48, 157, 0.08);
  }

  .section-orbit::before,
  .section-orbit::after {
    content: '';
    position: absolute;
    inset: 35px;
    border: 1px solid rgba(170, 130, 255, 0.1);
    border-radius: 50%;
  }

  .section-orbit span {
    position: absolute;
    top: 7%;
    right: 17%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 18px 5px rgba(185, 157, 255, 0.8);
  }

  .features-section {
    padding: 140px 0;
  }

  .section-heading {
    max-width: 700px;
    margin-bottom: 55px;
  }

  .section-heading > p:last-child {
    max-width: 600px;
    margin-top: 25px;
    color: rgba(245, 242, 255, 0.62);
    line-height: 2;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .feature-card {
    position: relative;
    min-height: 320px;
