```astro
---
const pageTitle = "نقشه تولد | Astro Negah";
---

<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>

    <style>
      :root {
        color-scheme: dark;
        --card: rgba(20, 25, 62, 0.82);
        --card-soft: rgba(8, 12, 34, 0.72);
        --border: rgba(145, 125, 255, 0.25);
        --text: #f4f2ff;
        --muted: #aaa7c7;
        --accent: #9b7cff;
        --accent-strong: #b69cff;
        --input: #111737;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family:
          Vazirmatn,
          Tahoma,
          Arial,
          sans-serif;
        color: var(--text);
        background:
          radial-gradient(
            circle at top,
            rgba(100, 76, 210, 0.24),
            transparent 42%
          ),
          linear-gradient(180deg, #090d25 0%, #050816 100%);
      }

      .page {
        width: min(100% - 32px, 1000px);
        margin: 0 auto;
        padding: 48px 0 80px;
      }

      .topbar {
        margin-bottom: 32px;
      }

      .back {
        color: var(--muted);
        text-decoration: none;
      }

      .back:hover {
        color: var(--accent-strong);
      }

      .hero {
        text-align: center;
        margin-bottom: 32px;
      }

      .eyebrow {
        margin: 0 0 10px;
        color: var(--accent-strong);
        font-size: 0.8rem;
        letter-spacing: 0.12em;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.2rem, 6vw, 4rem);
      }

      .intro {
        max-width: 600px;
        margin: 18px auto 0;
        color: var(--muted);
        line-height: 1.9;
      }

      .card {
        padding: clamp(24px, 5vw, 42px);
        border: 1px solid var(--border);
        border-radius: 24px;
        background: var(--card);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(18px);
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .field.full {
        grid-column: 1 / -1;
      }

      label {
        color: #dcd9f3;
        font-size: 0.92rem;
      }

      input {
        width: 100%;
        min-height: 50px;
        padding: 12px 14px;
        border: 1px solid rgba(160, 145, 255, 0.2);
        border-radius: 12px;
        outline: none;
        color: var(--text);
        background: var(--input);
        font: inherit;
        direction: rtl;
      }

      input[type="date"],
      input[type="time"],
      input[type="number"] {
        direction: ltr;
        text-align: left;
      }

      input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(155, 124, 255, 0.15);
      }

      .button-row {
        margin-top: 28px;
      }

      button {
        width: 100%;
        min-height: 54px;
        border: 0;
        border-radius: 14px;
        cursor: pointer;
        color: white;
        background: linear-gradient(135deg, #7658df, #a17dff);
        font: inherit;
        font-weight: 700;
        font-size: 1rem;
      }

      button:disabled {
        opacity: 0.65;
        cursor: wait;
      }

      .result {
        margin-top: 32px;
      }

      .result-card {
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--card-soft);
      }

      .result-card h2 {
        margin-top: 0;
        margin-bottom: 24px;
        font-size: 1.6rem;
      }

      .section {
        margin-top: 28px;
        padding-top: 28px;
        border-top: 1px solid rgba(145, 125, 255, 0.16);
      }

      .section:first-of-type {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
      }

      .section h3 {
        margin: 0 0 18px;
        color: var(--accent-strong);
        font-size: 1.2rem;
      }

      .summary {
        display: grid;
        gap: 12px;
      }

      .summary-item {
        padding: 16px 18px;
        border-radius: 14px;
        background: rgba(155, 124, 255, 0.07);
        line-height: 1.9;
      }

      .planet-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .planet {
        padding: 16px;
        border: 1px solid rgba(145, 125, 255, 0.12);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.025);
      }

      .planet-name {
        margin-bottom: 6px;
        font-weight: 700;
      }

      .planet-info {
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.8;
      }

      .aspect-list {
        display: grid;
        gap: 10px;
      }

      .aspect {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.025);
      }

      .aspect-name {
        font-weight: 600;
      }

      .aspect-detail {
        color: var(--muted);
        text-align: left;
        font-size: 0.9rem;
      }

      .cosmic-story {
        padding: 24px;
        border: 1px solid rgba(155, 124, 255, 0.24);
        border-radius: 18px;
        background:
          radial-gradient(
            circle at top right,
            rgba(155, 124, 255, 0.16),
            transparent 55%
          ),
          rgba(30, 24, 72, 0.42);
      }

      .cosmic-story h3 {
        margin-bottom: 12px;
      }

      .cosmic-intro {
        margin: 0 0 22px;
        color: #ddd8ff;
        font-size: 1.08rem;
        line-height: 1.9;
      }

      .story-block {
        margin-top: 18px;
      }

      .story-block strong {
        display: block;
        margin-bottom: 6px;
        color: var(--accent-strong);
      }

      .story-block p {
        margin: 0;
        color: var(--muted);
        line-height: 1.9;
      }

      .error {
        color: #ffb4b4;
      }

      @media (max-width: 680px) {
        .page {
          width: min(100% - 20px, 1000px);
          padding-top: 28px;
        }

        .form-grid,
        .planet-grid {
          grid-template-columns: 1fr;
        }

        .field.full {
          grid-column: auto;
        }

        .aspect {
          flex-direction: column;
        }

        .aspect-detail {
          text-align: right;
        }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <div class="topbar">
        <a class="back" href="/">← بازگشت به صفحه اصلی</a>
      </div>

      <header class="hero">
        <p class="eyebrow">Astro Negah</p>
        <h1>نقشه تولد</h1>
        <p class="intro">
          اطلاعات تولد خود را وارد کنید و نقشه منحصربه‌فرد آسمان تولدتان را کشف کنید.
        </p>
      </header>

      <section class="card">
        <form id="birth-chart-form">
          <div class="form-grid">
            <div class="field full">
              <label for="name">نام</label>
              <input
                id="name"
                type="text"
                name="name"
                placeholder="نام خود را وارد کنید"
              />
            </div>

            <div class="field">
              <label for="birthDate">تاریخ تولد</label>
              <input
                id="birthDate"
                type="date"
                name="birthDate"
                required
              />
            </div>

            <div class="field">
              <label for="birthTime">زمان تولد</label>
              <input
                id="birthTime"
                type="time"
                name="birthTime"
                required
              />
            </div>

            <div class="field full">
              <label for="timezone">منطقه زمانی</label>
              <input
                id="timezone"
                type="text"
                name="timezone"
                value="Asia/Tehran"
                required
              />
            </div>

            <div class="field">
              <label for="latitude">عرض جغرافیایی</label>
              <input
                id="latitude"
                type="number"
                name="latitude"
                step="any"
                value="35.6892"
                required
              />
            </div>

            <div class="field">
              <label for="longitude">طول جغرافیایی</label>
              <input
                id="longitude"
                type="number"
                name="longitude"
                step="any"
                value="51.3890"
                required
              />
            </div>
          </div>

          <div class="button-row">
            <button id="calculate-button" type="submit">
              محاسبه نقشه تولد
            </button>
          </div>
        </form>

        <section id="result" class="result" hidden>
          <div class="result-card">
            <h2>پروفایل کیهانی شما</h2>

            <div class="section">
              <h3>خلاصه شخصیت</h3>
              <div id="personality-summary" class="summary"></div>
            </div>

            <div class="section">
              <h3>سیارات و خانه‌ها</h3>
              <div id="planets-houses" class="planet-grid"></div>
            </div>

            <div class="section">
              <h3>جنبه‌های سیاره‌ای</h3>
              <div id="aspects" class="aspect-list"></div>
            </div>

            <div class="section">
              <div id="cosmic-story" class="cosmic-story"></div>
            </div>
          </div>
        </section>
      </section>
    </main>
  </body>

  <script>
    const form = document.getElementById("birth-chart-form");
    const resultSection = document.getElementById("result");
    const personalitySummary = document.getElementById("personality-summary");
    const planetsHouses = document.getElementById("planets-houses");
    const aspectsContainer = document.getElementById("aspects");
    const cosmicStory = document.getElementById("cosmic-story");
    const calculateButton = document.getElementById("calculate-button");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);

      const birthDate = formData.get("birthDate");
      const birthTime = formData.get("birthTime");
      const timezone = formData.get("timezone");
      const latitude = formData.get("latitude");
      const longitude = formData.get("longitude");

      const params = new URLSearchParams({
        birthDate,
        birthTime,
        timezone,
        latitude,
        longitude
      });

      resultSection.hidden = false;
      personalitySummary.innerHTML = "<div>در حال محاسبه...</div>";
      planetsHouses.innerHTML = "";
      aspectsContainer.innerHTML = "";
      cosmicStory.innerHTML = "";
      calculateButton.disabled = true;

      try {
        const response = await fetch(
          `/api/birth-chart?${params.toString()}`,
          {
            method: "GET",
            headers: {
              Accept: "application/json"
            }
          }
        );

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(
            data.error || "محاسبه نقشه تولد با خطا مواجه شد"
          );
        }

        const interpretation = data.interpretation;

        const personality = interpretation.personality_summary;

        personalitySummary.innerHTML = `
          <div class="summary-item">${personality.sun}</div>
          <div class="summary-item">${personality.moon}</div>
          <div class="summary-item">${personality.ascendant}</div>
        `;

        planetsHouses.innerHTML =
          interpretation.planets_and_houses
            .map(
              (planet) => `
                <div class="planet">
                  <div class="planet-name">${planet.planet}</div>
                  <div class="planet-info">
                    ${planet.sign} ${planet.degree}°${planet.minute}'
                    · خانه ${planet.house}
                    ${planet.retrograde ? " · برگشتی" : ""}
                  </div>
                </div>
              `
            )
            .join("");

        aspectsContainer.innerHTML =
          interpretation.aspects
            .map(
              (aspect) => `
                <div class="aspect">
                  <div class="aspect-name">
                    ${aspect.planet1} ${aspect.aspect} ${aspect.planet2}
                  </div>
                  <div class="aspect-detail">
                    اورب ${aspect.orb.toFixed(2)}°
                  </div>
                </div>
              `
            )
            .join("");

        const story = interpretation.cosmic_story;

        cosmicStory.innerHTML = `
          <h3>${story.title}</h3>
          <p class="cosmic-intro">${story.intro}</p>

          <div class="story-block">
            <strong>شخصیت شما</strong>
            <p>${story.personality}</p>
          </div>

          <div class="story-block">
            <strong>دنیای احساسی شما</strong>
            <p>${story.emotions}</p>
          </div>

          <div class="story-block">
            <strong>حضور و تأثیر شما</strong>
            <p>${story.presence}</p>
          </div>

          <div class="story-block">
            <strong>الگوی کیهانی شما</strong>
            <p>${story.reflection}</p>
          </div>
        `;
      } catch (error) {
        personalitySummary.innerHTML = `
          <div class="error">
            ${
              error instanceof Error
                ? error.message
                : "محاسبه نقشه تولد با خطا مواجه شد"
            }
          </div>
        `;
      } finally {
        calculateButton.disabled = false;
      }
    });
  </script>
</html>
```
