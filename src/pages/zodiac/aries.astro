    grid-template-columns: 330px 1fr;
    gap: 70px;
    align-items: center;

    padding: 55px;

    border: 1px solid rgba(180, 150, 255, 0.2);
    border-radius: 28px;

    background: rgba(19, 17, 55, 0.72);

    box-shadow:
      0 25px 80px rgba(0, 0, 0, 0.35);
  }

  .icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }

  .icon-wrap img {
    width: 220px;
    height: 220px;
    object-fit: contain;
  }

  .english-name {
    margin: 0 0 8px;

    color: #bca8ff;

    font-size: 14px;
    font-weight: 700;

    letter-spacing: 5px;

    direction: ltr;
  }

  h1 {
    margin: 0 0 20px;

    font-size: clamp(48px, 7vw, 78px);
    line-height: 1;
  }

  .intro {
    max-width: 650px;
