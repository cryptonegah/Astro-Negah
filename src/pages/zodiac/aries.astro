    line-height: 2;
  }

  .monthly-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 14px;

    margin-top: 35px;

    text-align: right;
  }

  .monthly-grid > div {
    padding: 22px;

    border-radius: 16px;

    background: rgba(255, 255, 255, 0.055);

    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* FINAL */

  .final-section {
    margin-top: 75px;

    padding: 60px 30px;

    text-align: center;
  }

  .final-section h2 {
    margin-bottom: 15px;
  }

  .final-section p {
    margin: 0 auto 25px;

    max-width: 650px;

    color: #bbb7cd;

    line-height: 2;
  }

  .final-section a {
    display: inline-block;

    padding: 13px 25px;

    border-radius: 999px;

    color: #ffffff;

    text-decoration: none;

    background: rgba(126, 86, 190, 0.55);

    border: 1px solid rgba(190, 160, 255, 0.25);

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .final-section a:hover {
    transform: translateY(-2px);

    background: rgba(126, 86, 190, 0.75);
  }

  /* MOBILE */

  @media (max-width: 760px) {

    .page {
      width: min(100% - 24px, 600px);

      padding-top: 22px;
    }

    .zodiac-hero {
      grid-template-columns: 1fr;

      gap: 20px;

      padding: 30px 22px;

      text-align: center;
    }

    .icon-wrap {
      min-height: 220px;
    }

    .icon-wrap img {
      width: 170px;
      height: 170px;
    }

    .intro {
      font-size: 17px;
    }

    .details {
      grid-template-columns: 1fr;
    }

    .section {
      margin-top: 40px;

      padding: 30px 22px;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    .split-section {
      grid-template-columns: 1fr;

      gap: 40px;
    }

    .career-grid {
      grid-template-columns: 1fr;
    }

    .compatibility-grid {
      grid-template-columns: 1fr 1fr;
    }

    .monthly-section {
      margin-top: 40px;

      padding: 35px 22px;
    }

    .monthly-grid {
      grid-template-columns: 1fr 1fr;
    }

    h2 {
      font-size: 27px;
    }
  }

  @media (max-width: 430px) {

    .compatibility-grid,
    .monthly-grid {
      grid-template-columns: 1fr;
    }

    .icon-wrap img {
      width: 150px;
      height: 150px;
    }
  }
</style>
