  }

  .detail-card strong,
  .small-card strong,
  .compatibility-grid strong,
  .monthly-grid strong {
    font-size: 17px;
  }

  /* GENERAL SECTIONS */

  .section {
    margin-top: 75px;
    padding: 45px;

    border-radius: 24px;

    background: rgba(19, 17, 55, 0.58);

    border: 1px solid rgba(180, 150, 255, 0.14);
  }

  .section-label {
    margin: 0 0 12px;

    color: #bca8ff;

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 4px;

    direction: ltr;
  }

  h2 {
    margin: 0 0 25px;

    font-size: 32px;
    line-height: 1.4;
  }

  .section-text {
    margin: 0 0 20px;

    color: #d1cede;

    font-size: 17px;
    line-height: 2.1;
  }

  /* CARDS */

  .cards {
