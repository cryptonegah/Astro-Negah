<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, Tahoma, sans-serif;
    color: #ffffff;

    background:
      radial-gradient(
        circle at 50% 10%,
        rgba(125, 75, 190, 0.28),
        transparent 32%
      ),
      linear-gradient(
        180deg,
        #080b25 0%,
        #0d1030 55%,
        #080a20 100%
      );
  }

  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  .page {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
    padding: 32px 0 90px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 45px;
    color: #d8c9ff;
